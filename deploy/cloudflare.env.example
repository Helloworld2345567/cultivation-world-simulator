# Copy this template to a secret file OUTSIDE the repository, then pass it with
# docker compose --env-file. Never commit the populated file.

# Intended public hostname. This is stack metadata only; configure the actual
# Public Hostname and origin in the Cloudflare Zero Trust dashboard.
CWS_PUBLIC_HOSTNAME=world.ym0v0.com
CWS_ALLOWED_ORIGINS=https://world.ym0v0.com

# Required backend administrator credentials. Use unique, randomly generated
# values. The session secret must be at least 32 characters.
CWS_ADMIN_PASSWORD=replace-with-a-long-random-password
CWS_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Required token for a remotely managed Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-tunnel-token

# Optional override. The default is the verified cloudflared 2026.8.2 image,
# pinned by immutable multi-architecture repository digest.
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:0aa26e284f05e6c77ae375b8c9c11d9eb6a448fb7bcd8d40f31cb6176189eb38
